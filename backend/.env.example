# Environment Configuration for AI-Powered Early Health Detection System
# Copy this file to ".env" and fill in your own values. Never commit the
# real ".env" file — it holds your live Gemini API key.

GEMINI_API_KEY=PUT_YOUR_GEMINI_API_KEY_HERE
SERVER_PORT=8080
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ai_health_center
